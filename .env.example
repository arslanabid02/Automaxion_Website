# Configure these values in your deployment's private environment settings.
# Do not commit a populated .env file or expose provider keys to browser code.
APP_LOGIN_EMAIL=
APP_LOGIN_PASSWORD=
AUTH_SECRET=

# Voice and calling provider defaults. Per-agent credentials belong in a
# secure server-side database once the CRM backend is connected.
RETELL_API_KEY=
ULTRAVOX_API_KEY=
FISH_AUDIO_API_KEY=
